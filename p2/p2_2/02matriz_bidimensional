// Na alocação de uma matriz bidimensional a de números float, 
// assinale a alternativa incorreta caso exista e corrija a afirmação:
// ( ) A alocação do vetor linha ocorre com: a = (float **) malloc(numLinhas * sizeof(float *));
// ( ) A alocação do elemento i do vetor linha ocorre com: 
// a[i] = (float *) malloc(numColunas * sizeof(float));
// ( ) A tentativa de alocação pode dar errado e ser capturada por if (a == NULL)
// ( ) O acesso ao elemento linha, coluna é feito com a[linha][coluna]
// (X) As afirmativas anteriores estão corretas.

#include <stdio.h>
#include <stdlib.h>

int main() {
    int numLinhas = 3, numColunas = 4;
    float **a;
    int i, j;
    
    // 1. Alocação do vetor de linhas (ponteiro para ponteiro)
    a = (float **) malloc(numLinhas * sizeof(float *));
    if (a == NULL) {
        printf("Erro de alocação das linhas!\n");
        exit(1);
    }
    
    // 2. Alocação de cada coluna para cada linha
    for (i = 0; i < numLinhas; i++) {
        a[i] = (float *) malloc(numColunas * sizeof(float));
        if (a[i] == NULL) {
            printf("Erro de alocação da coluna %d!\n", i);
            exit(1);
        }
    }
    
    // 3. Acesso aos elementos com sintaxe de matriz comum
    for (i = 0; i < numLinhas; i++) {
        for (j = 0; j < numColunas; j++) {
            a[i][j] = (float)(i + j);
            printf("%.1f ", a[i][j]);
        }
        printf("\n");
    }
    
    // Liberação de memória
    for (i = 0; i < numLinhas; i++) {
        free(a[i]);
    }
    free(a);
    
    return 0;
}